rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo il proprietario (Google, email verificata) può leggere/scrivere.
    // Il vecchio accesso via Admin SDK (Streamlit) non è toccato dalle regole.
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'mariodt79@gmail.com'
        && request.auth.token.email_verified == true;
    }
  }
}
